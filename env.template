# ─────────────────────────────────────────────────────────────
#  COPY-SOL — environment configuration
#  Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Solana RPC endpoint. publicnode is the generous default; for 10+ active
# wallets a paid endpoint (Helius / QuickNode) is still recommended.
SOLANA_RPC_URL=https://solana-rpc.publicnode.com

# WebSocket endpoint for push-based capture (~1s latency, near-100% coverage
# even on MEV-speed wallets). E.g. wss://mainnet.helius-rpc.com/?api-key=...
# Leave empty to rely on polling only.
SOLANA_WS_URL=

# HTTP server port for Railway healthchecks.
PORT=3000

# How often to poll each tracked wallet for new signatures (ms).
# The public RPC rate-limits aggressively; 15s is a safe floor for 10 wallets.
POLL_INTERVAL_MS=15000

# Master switch. Set false to serve HTTP healthchecks only.
COPYBOT_ENABLED=true

# Comma-separated wallet addresses to copy. Defaults to the starter list
# baked into src/copybot/constants.ts when left empty.
TRACKED_WALLETS=

# ── Copy sizing ──────────────────────────────────────────────
# Our entry = CLIP_PCT% of the copied wallet's trade notional.
CLIP_PCT=1
# Ignore copied trades whose notional is below this (USD). Ledger data shows
# wallet trades under ~$200 are overwhelmingly unprofitable to copy.
MIN_WALLET_TRADE_USD=200

# ── Paper account ────────────────────────────────────────────
STARTING_BUDGET_USD=10000
# Concurrency is budget-bound; this is only a safety valve.
MAX_POSITIONS=1000
# Realism: applied to fills.
ENTRY_SLIPPAGE_PCT=1
EXIT_SLIPPAGE_PCT=1
# Close a position when it is down this many percent (0 disables).
STOP_LOSS_PCT=40
# How often open positions are re-marked for the stop loss (ms).
MARK_INTERVAL_MS=60000

# ── Risk gates ───────────────────────────────────────────────
# Skip entries into tokens whose deepest DexScreener pool has less liquidity
# than this (USD). 0 disables. Missing/zero liquidity counts as below floor.
LIQUIDITY_FLOOR_USD=25000
# Stop copying a wallet while its cumulative realized PnL is at or below this
# (USD). Auto re-enables if realized PnL recovers. 0 disables.
KILL_SWITCH_PNL_USD=-50
# Win-rate kill: fires when a wallet has >= KILL_SWITCH_MIN_SELLS closed sells,
# negative PnL, and a win rate below KILL_SWITCH_MAX_WIN_RATE (0 disables).
KILL_SWITCH_MIN_SELLS=20
KILL_SWITCH_MAX_WIN_RATE=0.3
# Max accumulated cost per position, as a multiple of the first clip
# (blocks DCA-into-one-token loops). 0 disables.
TOP_UP_COST_CAP_MULTIPLE=2

# ── Wallet rankings ──────────────────────────────────────────
# UTC hours at which ranking reports are sent. Default "6,18" =
# 12:00am and 12:00pm GMT-6. Comma-separated, 0-23.
REPORT_HOURS_UTC=6,18

# ── Persistence ──────────────────────────────────────────────
DATA_DIR=data

# ── Telegram alerts ──────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Send a test alert on boot (normally disabled: only closes and rankings alert).
TELEGRAM_TEST_ON_BOOT=false

# Logging: debug | info | warn | error
LOG_LEVEL=info
