# ─────────────────────────────────────────────────────────────
#  COPY-SOL — environment configuration
#  Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Solana RPC endpoint. The public mainnet endpoint is rate-limited; a paid
# endpoint (Helius / QuickNode / Triton) is recommended for 10+ wallets.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# HTTP server port for Railway healthchecks.
PORT=3000

# How often to poll each tracked wallet for new signatures (ms).
POLL_INTERVAL_MS=5000

# Master switch. Set false to serve HTTP healthchecks only.
COPYBOT_ENABLED=true

# Comma-separated wallet addresses to copy. Defaults to the starter list
# baked into src/copybot/constants.ts when left empty.
TRACKED_WALLETS=

# ── Copy sizing ──────────────────────────────────────────────
# Our entry = CLIP_PCT% of the copied wallet's trade notional.
CLIP_PCT=1
# Ignore copied trades whose notional is below this (USD).
MIN_WALLET_TRADE_USD=50

# ── Paper account ────────────────────────────────────────────
STARTING_BUDGET_USD=1000
# Max simultaneous open positions.
MAX_POSITIONS=40
# Realism: applied to fills.
ENTRY_SLIPPAGE_PCT=1
EXIT_SLIPPAGE_PCT=1
# Close a position when it is down this many percent (0 disables).
STOP_LOSS_PCT=40
# How often open positions are re-marked for the stop loss (ms).
MARK_INTERVAL_MS=60000

# ── Wallet rankings ──────────────────────────────────────────
# UTC hour at which the daily wallet-ranking report is sent.
DAILY_REPORT_HOUR_UTC=0

# ── Persistence ──────────────────────────────────────────────
DATA_DIR=data

# ── Telegram alerts ──────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Send a test alert on boot.
TELEGRAM_TEST_ON_BOOT=true

# Logging: debug | info | warn | error
LOG_LEVEL=info
